datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Kullanıcı Teklif ve İletişim İstekleri
model QuoteRequest {
  id        String   @id @default(cuid())
  adSoyad   String
  telefon   String
  hizmet    String
  ilce      String?
  detay     String?
  kaynak    String   // "Ana Sayfa", "Ferforje Kapı", "İletişim" vb.
  createdAt DateTime @default(now())
}

// 2. Hizmet Detayları
model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  categoryName     String?
  categorySlug     String?
  description      String
  imageUrl         String
  featuresJson     String   // JSON string: Örn. ["Usta işçilik", "Paslanmaz astar"]
  waMessage        String   // Bu hizmete özel varsayılan WhatsApp mesaj şablonu
  order            Int      @default(0)
}

// 3. SSS (Sık Sorulan Sorular)
model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
}

// 4. Blog Yazıları
model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  summary   String
  content   String   // Markdown veya zengin metin içeriği
  tagsJson  String   // JSON string: Örn. ["bahçe kapısı fiyatları", "balkon korkuluğu"]
  createdAt DateTime @default(now())
}

// 5. Bölgesel SEO / İlçe Bilgileri
model DistrictPage {
  id           String   @id @default(cuid())
  name         String   // Örn. "Şişli"
  slug         String   @unique // Örn. "sisli-demir-dograma"
  categorySlug String   // Örn. "sisli-demir-dogramaci"
  content      String   // Bölgeye özel tanıtım içeriği
}

// 6. Bilgilendirme Rehberleri
model Guide {
  id               String   @id @default(cuid())
  title            String
  description      String
  imageUrl         String
  targetServiceSlug String  // Yönlendirilecek hizmet sayfası slug'ı
}
